
import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert
} from 'react-native';

export default function App() {

  const [temperatura, setTemperatura] = useState('');
  const [direcao, setDirecao] = useState('C-F');
  const [resultado, setResultado] = useState(null);

  // Realizar conversão
  function converter() {

    if (temperatura.trim() === '') {
      Alert.alert(
        'Atenção',
        'Digite uma temperatura para converter.'
      );
      return;
    }

    const valor = Number(
      temperatura.replace(',', '.')
    );

    if (!Number.isFinite(valor)) {
      Alert.alert(
        'Valor inválido',
        'Digite uma temperatura numérica válida.'
      );
      return;
    }

    let convertido;

    if (direcao === 'C-F') {
      convertido = (valor * 9 / 5) + 32;

      setResultado({
        valor: convertido.toFixed(2),
        unidade: '°F'
      });

    } else {
      convertido = (valor - 32) * 5 / 9;

      setResultado({
        valor: convertido.toFixed(2),
        unidade: '°C'
      });
    }
  }

  // Limpar campos
  function limpar() {
    setTemperatura('');
    setResultado(null);
  }

  return (
    <View style={styles.container}>

      <Text style={styles.icone}>🌡️</Text>

      <Text style={styles.titulo}>
        Conversor de Temperatura
      </Text>

      <Text style={styles.subtitulo}>
        Converta temperaturas entre Celsius e Fahrenheit
      </Text>

      {/* Seleção da conversão */}
      <View style={styles.card}>

        <Text style={styles.label}>
          Escolha o tipo de conversão:
        </Text>

        <View style={styles.opcoes}>

          <TouchableOpacity
            style={[
              styles.botaoOpcao,
              direcao === 'C-F' && styles.opcaoSelecionada
            ]}
            onPress={() => {
              setDirecao('C-F');
              setResultado(null);
            }}
          >
            <Text style={[
              styles.textoOpcao,
              direcao === 'C-F' && styles.textoSelecionado
            ]}>
              °C → °F
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={[
              styles.botaoOpcao,
              direcao === 'F-C' && styles.opcaoSelecionada
            ]}
            onPress={() => {
              setDirecao('F-C');
              setResultado(null);
            }}
          >
            <Text style={[
              styles.textoOpcao,
              direcao === 'F-C' && styles.textoSelecionado
            ]}>
              °F → °C
            </Text>
          </TouchableOpacity>

        </View>

        {/* Campo de temperatura */}
        <Text style={styles.label}>
          {direcao === 'C-F'
            ? 'Temperatura em Celsius (°C):'
            : 'Temperatura em Fahrenheit (°F):'}
        </Text>

        <TextInput
          style={styles.input}
          placeholder={
            direcao === 'C-F'
              ? 'Exemplo: 30'
              : 'Exemplo: 86'
          }
          keyboardType="decimal-pad"
          value={temperatura}
          onChangeText={(texto) => {
            setTemperatura(texto);
            setResultado(null);
          }}
        />

        {/* Botão converter */}
        <TouchableOpacity
          style={styles.botaoConverter}
          onPress={converter}
        >
          <Text style={styles.textoBotao}>
            Converter temperatura
          </Text>
        </TouchableOpacity>

      </View>

      {/* Resultado */}
      {resultado !== null && (

        <View style={styles.resultado}>

          <Text style={styles.resultadoTitulo}>
            Resultado da conversão
          </Text>

          <Text style={styles.valorResultado}>
            {resultado.valor.replace('.', ',')} {resultado.unidade}
          </Text>

          <Text style={styles.descricao}>
            {direcao === 'C-F'
              ? 'Celsius para Fahrenheit'
              : 'Fahrenheit para Celsius'}
          </Text>

        </View>

      )}

      {/* Botão limpar */}
      <TouchableOpacity
        style={styles.botaoLimpar}
        onPress={limpar}
      >
        <Text style={styles.textoLimpar}>
          Limpar
        </Text>
      </TouchableOpacity>

      <Text style={styles.rodape}>
        Conversão entre escalas de temperatura
      </Text>

    </View>
  );
}

