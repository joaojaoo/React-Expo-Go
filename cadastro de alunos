
import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  ScrollView,
  Alert
} from 'react-native';

export default function App() {
  const [nome, setNome] = useState('');
  const [matricula, setMatricula] = useState('');
  const [email, setEmail] = useState('');
  const [curso, setCurso] = useState('');

  const [estudantes, setEstudantes] = useState([]);

  // Cadastra um novo estudante
  function cadastrarEstudante() {
    if (
      nome.trim() === '' ||
      matricula.trim() === '' ||
      email.trim() === '' ||
      curso.trim() === ''
    ) {
      Alert.alert('Atenção', 'Preencha todos os campos obrigatórios.');
      return;
    }

    // Validação simples de e-mail
    if (!email.includes('@') || !email.includes('.')) {
      Alert.alert('E-mail inválido', 'Digite um endereço de e-mail válido.');
      return;
    }

    // Verifica se a matrícula já está cadastrada
    const matriculaExiste = estudantes.some(
      (estudante) => estudante.matricula === matricula.trim()
    );

    if (matriculaExiste) {
      Alert.alert(
        'Matrícula duplicada',
        'Já existe um estudante cadastrado com essa matrícula.'
      );
      return;
    }

    // Cria o objeto do estudante
    const novoEstudante = {
      id: Date.now().toString(),
      nome: nome.trim(),
      matricula: matricula.trim(),
      email: email.trim(),
      curso: curso.trim()
    };

    // Adiciona o objeto ao array
    setEstudantes((anterior) => [...anterior, novoEstudante]);

    Alert.alert('Sucesso!', 'Estudante cadastrado com sucesso.');

    // Limpa os campos
    setNome('');
    setMatricula('');
    setEmail('');
    setCurso('');
  }

  // Remove um estudante pelo ID
  function removerEstudante(id) {
    Alert.alert(
      'Remover estudante',
      'Deseja realmente remover este cadastro?',
      [
        {
          text: 'Cancelar',
          style: 'cancel'
        },
        {
          text: 'Remover',
          style: 'destructive',
          onPress: () => {
            setEstudantes((anterior) =>
              anterior.filter((estudante) => estudante.id !== id)
            );
          }
        }
      ]
    );
  }

  return (
    <ScrollView
      style={styles.container}
      contentContainerStyle={styles.conteudo}
      keyboardShouldPersistTaps="handled"
    >
      <View style={styles.header}>
        <Text style={styles.titulo}>🎓 Cadastro de Estudantes</Text>
        <Text style={styles.subtitulo}>
          Sistema de gerenciamento acadêmico
        </Text>
      </View>

      <View style={styles.formulario}>
        <Text style={styles.tituloFormulario}>
          Novo estudante
        </Text>

        <Text style={styles.label}>Nome completo</Text>
        <TextInput
          style={styles.input}
          placeholder="Digite o nome do estudante"
          value={nome}
          onChangeText={setNome}
        />

        <Text style={styles.label}>Matrícula</Text>
        <TextInput
          style={styles.input}
          placeholder="Digite a matrícula"
          value={matricula}
          onChangeText={setMatricula}
          keyboardType="numeric"
        />

        <Text style={styles.label}>E-mail</Text>
        <TextInput
          style={styles.input}
          placeholder="exemplo@email.com"
          value={email}
          onChangeText={setEmail}
          keyboardType="email-address"
          autoCapitalize="none"
        />

        <Text style={styles.label}>Curso</Text>
        <TextInput
          style={styles.input}
          placeholder="Digite o curso"
          value={curso}
          onChangeText={setCurso}
        />

        <TouchableOpacity
          style={styles.botaoCadastrar}
          onPress={cadastrarEstudante}
        >
          <Text style={styles.textoBotao}>
            + CADASTRAR ESTUDANTE
          </Text>
        </TouchableOpacity>
      </View>

      <View style={styles.areaLista}>
        <View style={styles.cabecalhoLista}>
          <Text style={styles.tituloLista}>
            Estudantes cadastrados
          </Text>

          <View style={styles.contador}>
            <Text style={styles.textoContador}>
              {estudantes.length}
            </Text>
          </View>
        </View>

        {estudantes.length === 0 ? (
          <View style={styles.vazio}>
            <Text style={styles.iconeVazio}>📚</Text>
            <Text style={styles.textoVazio}>
              Nenhum estudante cadastrado.
            </Text>
            <Text style={styles.dicaVazio}>
              Preencha os campos acima para adicionar o primeiro estudante.
            </Text>
          </View>
        ) : (
          estudantes.map((estudante) => (
            <View key={estudante.id} style={styles.card}>
              <View style={styles.cardCabecalho}>
                <View style={styles.avatar}>
                  <Text style={styles.avatarTexto}>
                    {estudante.nome.charAt(0).toUpperCase()}
                  </Text>
                </View>

                <View style={styles.dadosPrincipais}>
                  <Text style={styles.nomeEstudante}>
                    {estudante.nome}
                  </Text>
                  <Text style={styles.matriculaEstudante}>
                    Matrícula: {estudante.matricula}
                  </Text>
                </View>
              </View>

              <View style={styles.divisor} />

              <Text style={styles.dado}>
                ✉️ {estudante.email}
              </Text>

              <Text style={styles.dado}>
                🎓 {estudante.curso}
              </Text>

              <TouchableOpacity
                style={styles.botaoRemover}
                onPress={() => removerEstudante(estudante.id)}
              >
                <Text style={styles.textoRemover}>
                  Remover cadastro
                </Text>
              </TouchableOpacity>
            </View>
          ))
        )}
      </View>

      <Text style={styles.rodape}>
        Sistema acadêmico – Projeto React Native
      </Text>
    </ScrollView>
  );
}

