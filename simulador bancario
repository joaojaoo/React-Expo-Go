import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert,
  ScrollView
} from 'react-native';

export default function App() {

  const [saldo, setSaldo] = useState(1000);
  const [valor, setValor] = useState('');
  const [historico, setHistorico] = useState([]);

  // Formatar valores em reais
  function formatarMoeda(numero) {
    return numero.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });
  }

  // Realizar depósito
  function depositar() {

    if (valor.trim() === '') {
      Alert.alert('Atenção', 'Informe o valor do depósito.');
      return;
    }

    const quantia = Number(valor.replace(',', '.'));

    if (!Number.isFinite(quantia) || quantia <= 0) {
      Alert.alert(
        'Valor inválido',
        'Digite um valor maior que zero.'
      );
      return;
    }

    const novoSaldo = saldo + quantia;

    setSaldo(novoSaldo);

    setHistorico([
      {
        tipo: 'Depósito',
        valor: quantia
      },
      ...historico
    ]);

    setValor('');

    Alert.alert(
      'Depósito realizado!',
      `Você depositou ${formatarMoeda(quantia)}.`
    );
  }

  // Realizar saque
  function sacar() {

    if (valor.trim() === '') {
      Alert.alert('Atenção', 'Informe o valor do saque.');
      return;
    }

    const quantia = Number(valor.replace(',', '.'));

    if (!Number.isFinite(quantia) || quantia <= 0) {
      Alert.alert(
        'Valor inválido',
        'Digite um valor maior que zero.'
      );
      return;
    }

    if (quantia > saldo) {
      Alert.alert(
        'Saldo insuficiente!',
        'Você não possui saldo suficiente para realizar este saque.'
      );
      return;
    }

    const novoSaldo = saldo - quantia;

    setSaldo(novoSaldo);

    setHistorico([
      {
        tipo: 'Saque',
        valor: quantia
      },
      ...historico
    ]);

    setValor('');

    Alert.alert(
      'Saque realizado!',
      `Você retirou ${formatarMoeda(quantia)}.`
    );
  }

  // Reiniciar conta
  function reiniciar() {
    Alert.alert(
      'Reiniciar conta',
      'Deseja realmente voltar ao saldo inicial de R$ 1.000,00?',
      [
        {
          text: 'Cancelar',
          style: 'cancel'
        },
        {
          text: 'Confirmar',
          onPress: () => {
            setSaldo(1000);
            setValor('');
            setHistorico([]);
          }
        }
      ]
    );
  }

  return (
    <ScrollView
      style={styles.scroll}
      contentContainerStyle={styles.container}
      keyboardShouldPersistTaps="handled"
    >

      <Text style={styles.icone}>🏦</Text>

      <Text style={styles.titulo}>
        Simulador Bancário
      </Text>

      <Text style={styles.subtitulo}>
        Gerencie seu saldo e suas movimentações
      </Text>

      {/* Saldo da conta */}
      <View style={styles.cardSaldo}>

        <Text style={styles.labelSaldo}>
          SALDO DISPONÍVEL
        </Text>

        <Text style={styles.saldo}>
          {formatarMoeda(saldo)}
        </Text>

        <Text style={styles.infoSaldo}>
          Conta simulada
        </Text>

      </View>

      {/* Operações */}
      <View style={styles.card}>

        <Text style={styles.tituloCard}>
          💰 Nova movimentação
        </Text>

        <Text style={styles.label}>
          Valor da operação (R$)
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Exemplo: 200,00"
          keyboardType="decimal-pad"
          value={valor}
          onChangeText={setValor}
        />

        <TouchableOpacity
          style={styles.botaoDeposito}
          onPress={depositar}
        >
          <Text style={styles.textoBotao}>
            + Depositar
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.botaoSaque}
          onPress={sacar}
        >
          <Text style={styles.textoBotao}>
            - Sacar
          </Text>
        </TouchableOpacity>

      </View>

      {/* Histórico */}
      <View style={styles.card}>

        <Text style={styles.tituloCard}>
          📋 Histórico de operações
        </Text>

        {historico.length === 0 ? (

          <Text style={styles.semHistorico}>
            Nenhuma movimentação realizada.
          </Text>

        ) : (

          historico.map((item, index) => (

            <View
              key={index}
              style={styles.itemHistorico}
            >

              <View>
                <Text style={styles.tipoHistorico}>
                  {item.tipo}
                </Text>

                <Text style={styles.descricaoHistorico}>
                  {index === 0
                    ? 'Movimentação recente'
                    : 'Movimentação anterior'}
                </Text>
              </View>

              <Text
                style={[
                  styles.valorHistorico,
                  item.tipo === 'Depósito'
                    ? styles.valorPositivo
                    : styles.valorNegativo
                ]}
              >
                {item.tipo === 'Depósito' ? '+' : '-'}
                {formatarMoeda(item.valor)}
              </Text>

            </View>

          ))

        )}

      </View>

      <TouchableOpacity
        style={styles.botaoReiniciar}
        onPress={reiniciar}
      >
        <Text style={styles.textoReiniciar}>
          Reiniciar conta
        </Text>
      </TouchableOpacity>

      <Text style={styles.rodape}>
        Simulador acadêmico. Não realiza operações financeiras reais.
      </Text>

    </ScrollView>
  );
}

