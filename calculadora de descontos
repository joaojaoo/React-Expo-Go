
import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  ScrollView,
  Alert
} from 'react-native';

export default function App() {
  const [produto, setProduto] = useState('');
  const [preco, setPreco] = useState('');
  const [desconto, setDesconto] = useState('');
  const [resultado, setResultado] = useState(null);

  function calcularDesconto() {
    const precoOriginal = Number(preco.replace(',', '.'));
    const percentual = Number(desconto.replace(',', '.'));

    if (produto.trim() === '' || preco.trim() === '' || desconto.trim() === '') {
      Alert.alert('Atenção', 'Preencha todos os campos.');
      return;
    }

    if (!Number.isFinite(precoOriginal) || precoOriginal < 0) {
      Alert.alert('Valor inválido', 'Informe um preço igual ou maior que zero.');
      return;
    }

    if (!Number.isFinite(percentual) || percentual < 0 || percentual > 100) {
      Alert.alert('Desconto inválido', 'Informe um desconto entre 0% e 100%.');
      return;
    }

    const economia = precoOriginal * (percentual / 100);
    const precoFinal = precoOriginal - economia;

    setResultado({
      nome: produto.trim(),
      original: precoOriginal,
      percentual: percentual,
      economia: economia,
      final: precoFinal
    });
  }

  function limparCampos() {
    setProduto('');
    setPreco('');
    setDesconto('');
    setResultado(null);
  }

  function formatarMoeda(valor) {
    return valor.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });
  }

  return (
    <ScrollView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.titulo}>🛍️ Calculadora de Desconto</Text>
        <Text style={styles.subtitulo}>
          Descubra quanto você economiza!
        </Text>
      </View>

      <View style={styles.formulario}>
        <Text style={styles.label}>Nome do produto</Text>
        <TextInput
          style={styles.input}
          placeholder="Ex: Camiseta"
          value={produto}
          onChangeText={setProduto}
        />

        <Text style={styles.label}>Preço original (R$)</Text>
        <TextInput
          style={styles.input}
          placeholder="Ex: 100,00"
          value={preco}
          onChangeText={setPreco}
          keyboardType="decimal-pad"
        />

        <Text style={styles.label}>Desconto (%)</Text>
        <TextInput
          style={styles.input}
          placeholder="Ex: 20"
          value={desconto}
          onChangeText={setDesconto}
          keyboardType="decimal-pad"
        />

        <TouchableOpacity
          style={styles.botaoCalcular}
          onPress={calcularDesconto}
        >
          <Text style={styles.textoBotao}>CALCULAR DESCONTO</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.botaoLimpar}
          onPress={limparCampos}
        >
          <Text style={styles.textoBotaoLimpar}>Limpar campos</Text>
        </TouchableOpacity>
      </View>

      {resultado && (
        <View style={styles.resultado}>
          <Text style={styles.resultadoTitulo}>
            Resultado da compra
          </Text>

          <Text style={styles.nomeProduto}>
            {resultado.nome}
          </Text>

          <View style={styles.linha}>
            <Text style={styles.descricao}>Preço original:</Text>
            <Text style={styles.valor}>
              {formatarMoeda(resultado.original)}
            </Text>
          </View>

          <View style={styles.linha}>
            <Text style={styles.descricao}>Desconto aplicado:</Text>
            <Text style={styles.valor}>
              {resultado.percentual}%
            </Text>
          </View>

          <View style={styles.linha}>
            <Text style={styles.descricao}>Você economizou:</Text>
            <Text style={styles.economia}>
              {formatarMoeda(resultado.economia)}
            </Text>
          </View>

          <View style={styles.separador} />

          <Text style={styles.precoFinalLabel}>
            PREÇO FINAL
          </Text>
          <Text style={styles.precoFinal}>
            {formatarMoeda(resultado.final)}
          </Text>
        </View>
      )}

      <Text style={styles.rodape}>
        Calculadora de desconto – Projeto acadêmico
      </Text>
    </ScrollView>
  );
}

