
import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert,
  ScrollView
} from 'react-native';

export default function App() {

  const [nome, setNome] = useState('');
  const [quantidadeInicial, setQuantidadeInicial] = useState('');
  const [movimentacao, setMovimentacao] = useState('');

  const [produto, setProduto] = useState(null);

  // Cadastrar produto e definir estoque inicial
  function cadastrarProduto() {

    if (nome.trim() === '' || quantidadeInicial.trim() === '') {
      Alert.alert('Atenção', 'Preencha todos os campos do produto.');
      return;
    }

    const quantidade = Number(quantidadeInicial);

    if (
      !Number.isInteger(quantidade) ||
      quantidade < 0
    ) {
      Alert.alert(
        'Valor inválido',
        'Informe uma quantidade inteira igual ou maior que zero.'
      );
      return;
    }

    setProduto({
      nome: nome.trim(),
      quantidade: quantidade
    });

    setMovimentacao('');

    if (quantidade < 5) {
      Alert.alert(
        'Atenção: estoque baixo!',
        'O produto possui menos de cinco unidades disponíveis.'
      );
    } else {
      Alert.alert(
        'Sucesso!',
        'Produto cadastrado com sucesso.'
      );
    }
  }

  // Adicionar produtos ao estoque
  function adicionarEstoque() {

    if (!produto) {
      Alert.alert('Atenção', 'Cadastre um produto primeiro.');
      return;
    }

    if (movimentacao.trim() === '') {
      Alert.alert('Atenção', 'Informe a quantidade.');
      return;
    }

    const quantidade = Number(movimentacao);

    if (!Number.isInteger(quantidade) || quantidade <= 0) {
      Alert.alert(
        'Valor inválido',
        'Informe uma quantidade inteira maior que zero.'
      );
      return;
    }

    const novoEstoque = produto.quantidade + quantidade;

    setProduto({
      ...produto,
      quantidade: novoEstoque
    });

    setMovimentacao('');

    Alert.alert(
      'Estoque atualizado!',
      `${quantidade} unidades adicionadas ao estoque.`
    );
  }

  // Retirar produtos do estoque
  function retirarEstoque() {

    if (!produto) {
      Alert.alert('Atenção', 'Cadastre um produto primeiro.');
      return;
    }

    if (movimentacao.trim() === '') {
      Alert.alert('Atenção', 'Informe a quantidade.');
      return;
    }

    const quantidade = Number(movimentacao);

    if (!Number.isInteger(quantidade) || quantidade <= 0) {
      Alert.alert(
        'Valor inválido',
        'Informe uma quantidade inteira maior que zero.'
      );
      return;
    }

    if (quantidade > produto.quantidade) {
      Alert.alert(
        'Estoque insuficiente!',
        'Não é possível retirar mais unidades do que existem disponíveis.'
      );
      return;
    }

    const novoEstoque = produto.quantidade - quantidade;

    setProduto({
      ...produto,
      quantidade: novoEstoque
    });

    setMovimentacao('');

    if (novoEstoque < 5) {
      Alert.alert(
        'Atenção: estoque baixo!',
        `Restam apenas ${novoEstoque} unidades de ${produto.nome}.`
      );
    } else {
      Alert.alert(
        'Retirada realizada!',
        `${quantidade} unidades retiradas com sucesso.`
      );
    }
  }

  // Limpar todos os dados
  function limpar() {
    setNome('');
    setQuantidadeInicial('');
    setMovimentacao('');
    setProduto(null);
  }

  return (
    <ScrollView
      style={styles.scroll}
      contentContainerStyle={styles.container}
      keyboardShouldPersistTaps="handled"
    >

      <Text style={styles.icone}>📦</Text>

      <Text style={styles.titulo}>
        Controle de Estoque
      </Text>

      <Text style={styles.subtitulo}>
        Gerencie as entradas e saídas dos seus produtos
      </Text>

      {/* Cadastro do produto */}
      <View style={styles.card}>

        <Text style={styles.tituloCard}>
          📋 Cadastro do produto
        </Text>

        <Text style={styles.label}>
          Nome do produto
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Exemplo: Arroz"
          value={nome}
          onChangeText={setNome}
        />

        <Text style={styles.label}>
          Quantidade inicial
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Exemplo: 20"
          keyboardType="number-pad"
          value={quantidadeInicial}
          onChangeText={setQuantidadeInicial}
        />

        <TouchableOpacity
          style={styles.botaoCadastrar}
          onPress={cadastrarProduto}
        >
          <Text style={styles.textoBotao}>
            Cadastrar produto
          </Text>
        </TouchableOpacity>

      </View>

      {/* Estoque atual */}
      {produto !== null && (

        <View style={styles.cardEstoque}>

          <Text style={styles.tituloCard}>
            📊 Estoque atual
          </Text>

          <Text style={styles.nomeProduto}>
            {produto.nome}
          </Text>

          <Text style={styles.quantidade}>
            {produto.quantidade}
          </Text>

          <Text style={styles.unidades}>
            unidades disponíveis
          </Text>

          {produto.quantidade < 5 ? (
            <Text style={styles.alerta}>
              ⚠️ Estoque baixo! Precisa repor.
            </Text>
          ) : (
            <Text style={styles.estoqueNormal}>
              ✓ Estoque em situação normal
            </Text>
          )}

        </View>
      )}

      {/* Movimentação do estoque */}
      <View style={styles.card}>

        <Text style={styles.tituloCard}>
          🔄 Movimentação
        </Text>

        <Text style={styles.label}>
          Quantidade movimentada
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Digite a quantidade"
          keyboardType="number-pad"
          value={movimentacao}
          onChangeText={setMovimentacao}
        />

        <TouchableOpacity
          style={styles.botaoAdicionar}
          onPress={adicionarEstoque}
        >
          <Text style={styles.textoBotao}>
            + Adicionar estoque
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.botaoRetirar}
          onPress={retirarEstoque}
        >
          <Text style={styles.textoBotao}>
            - Retirar estoque
          </Text>
        </TouchableOpacity>

      </View>

      <TouchableOpacity
        style={styles.botaoLimpar}
        onPress={limpar}
      >
        <Text style={styles.textoLimpar}>
          Limpar tudo
        </Text>
      </TouchableOpacity>

      <Text style={styles.rodape}>
        Sistema de controle de estoque
      </Text>

    </ScrollView>
  );
}

